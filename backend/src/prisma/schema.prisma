// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Clinic {
  id      String  @id @default(uuid())
  name    String
  address String?
  phone   String?
  logoPath String?

  lastEditedById String?
  lastEditedBy   User?   @relation("ClinicLastEditor", fields: [lastEditedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

enum UserRole {
  ADMIN
  DOCTOR
  ASSISTANT
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id         String   @id @default(uuid())
  firstName  String
  middleName String
  lastName   String
  username   String   @unique
  password   String
  role       UserRole
  licenseNum String?

  isActive Boolean @default(true)

  patientsLastEdited Patient[] @relation("PatientLastEditor")
  clinicsLastEdited  Clinic[]  @relation("ClinicLastEditor")
  recordsLastEdited  Record[]  @relation("RecordLastEditor")

  createdRecords Record[] @relation("RecordCreator")

  cases Case[]

  createdAt  DateTime     @default(now())
  records    Record[]
  systemLogs SystemLogs[]
  clinics    Clinic[]
  signatures Signature?

  invoicesCreated  Invoice[] @relation("InvoiceCreator")
  paymentsReceived Payment[] @relation("PaymentReceiver")
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  middleName  String
  lastName    String
  phone       String   @unique
  address     String
  sex         Sex
  dateOfBirth DateTime
  allergies   String?

  isArchived Boolean   @default(false)
  archivedOn DateTime?

  cases   Case[]
  records Record[]

  lastEditedById String?
  lastEditedBy   User?   @relation("PatientLastEditor", fields: [lastEditedById], references: [id])

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  labResults labResult[]
  invoices   Invoice[]
  payments   Payment[]
}

model Case {
  id        String @id @default(uuid())
  caseName  String
  patientId String

  records Record[]

  doctorId String?
  doctor   User?   @relation(fields: [doctorId], references: [id])

  patient Patient @relation(fields: [patientId], references: [id])

  isArchived Boolean   @default(false)
  archivedOn DateTime?
}

model Record {
  id        String   @id @default(uuid())
  patientId String
  visitDate DateTime @default(now())

  isArchived Boolean   @default(false)
  archivedOn DateTime?

  symptoms  String?
  signs     String?
  diagnosis String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  vitalSigns        VitalSigns?
  recordMedications RecordMedication[]

  caseId String
  case   Case    @relation(fields: [caseId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  lastEditedById String?
  lastEditedBy   User?   @relation("RecordLastEditor", fields: [lastEditedById], references: [id])

  createdById String
  createdBy   User   @relation("RecordCreator", fields: [createdById], references: [id])

  invoices Invoice[]
}

model VitalSigns {
  id       String @id @default(uuid())
  recordId String @unique
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?

  temperature Float?
  weightKg    Float?
}

model RecordMedication {
  id       String @id @default(uuid())
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId String

  name         String
  dosage       String
  frequency    String
  durationDays Int?
  instructions String?

  createdAt DateTime @default(now())
}

model labResult {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String
  filePath   String
  uploadedAt DateTime @default(now())
}

model Signature {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  filePath   String
  uploadedAt DateTime @default(now())
}

model GoogleToken {
  id           Int      @id @default(autoincrement())
  refreshToken String
  email        String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemLogs {
  id String @id @default(uuid())

  action  String
  module  String
  target  String
  details String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

enum ServiceCategory {
  CONSULTATION
  PROCEDURE
  MEDICATION
  LABORATORY
  SUPPLIES
  OTHER
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  HMO_INSURANCE
  OTHER
}

model ServiceCatalog {
  id           String          @id @default(uuid())
  name         String
  category     ServiceCategory @default(CONSULTATION)
  defaultPrice Float
  description  String?
  isActive     Boolean         @default(true)

  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordId      String?
  record        Record?       @relation(fields: [recordId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id])

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  status    InvoiceStatus @default(UNPAID)

  subtotal       Float        @default(0)
  discountType   DiscountType @default(NONE)
  discountValue  Float        @default(0)
  discountAmount Float        @default(0)
  discountReason String?
  taxRate        Float        @default(0)
  taxAmount      Float        @default(0)
  totalAmount    Float        @default(0)
  paidAmount     Float        @default(0)
  balance        Float        @default(0)
  notes          String?

  isArchived Boolean   @default(false)
  archivedOn DateTime?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceId String?
  service   ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  name      String
  category  ServiceCategory @default(OTHER)
  unitPrice Float
  quantity  Int             @default(1)
  total     Float

  createdAt DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receivedById  String
  receivedBy    User          @relation("PaymentReceiver", fields: [receivedById], references: [id])

  amount          Float
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?
  paymentDate     DateTime      @default(now())
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
