{
  "appId": "com.vryonantonio.clinicsync",
  "productName": "Clinic Sync",

  "directories": {
    "output": "release"
  },

  "files": ["dist/**/*"],

  "extraResources": [
    {
      "from": "../frontend/dist",
      "to": "frontend"
    },
    {
      "from": "../backend/dist",
      "to": "backend/dist"
    },
    {
      "from": "../backend/node_modules",
      "to": "backend/node_modules"
    },
    {
      "from": "../backend/package.json",
      "to": "backend/package.json"
    },
    {
      "from": "../backend/src/generated",
      "to": "backend/generated"
    },
    {
      "from": "../backend/src/prisma",
      "to": "backend/prisma"
    },
    {
      "from": "../backend/.env",
      "to": "backend/.env"
    }
  ],

  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "category": "public.app-category.medical",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "identity": null
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
